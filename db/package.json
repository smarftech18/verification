{
  "name": "deploy",
  "dependencies": {
    "hdb": "^2.0.0",
    "@sap/hdi-deploy": "^5"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "start": "node node_modules/@sap/hdi-deploy/deploy.js --use-hdb --parameter com.sap.hana.di.table/try_fast_table_migration=true",
    "build": "npm i && npx cds build .. --for hana --production"
  },
  "cds": {
    "requires": {
      "S4_READ_SERVICE": { "kind": "odata-v4", "mocked": true },
      "S4_UPDATE_SERVICE": { "kind": "odata-v4", "mocked": true },
      "BTP_REMOTE_SERVICE": { "kind": "odata-v4", "mocked": true }
    }
  }
}
